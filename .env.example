# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devevents
# Set to false only for a standalone mongod without a replica set (Atlas supports transactions)
MONGODB_TRANSACTIONS=true

# Cloudinary, used for event image uploads (required to create events)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# PostHog analytics (optional; analytics stay off when the key is empty)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Better Auth: organiser accounts and sessions
# 32+ random bytes, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public origin. Used for OAuth callbacks, trusted origins, and links in emails
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app. Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client. Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP server for verification, reset, and attendee emails (sent with Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465
SMTP_SECURE=false
EMAIL_FROM="DevEvent <no-reply@gmail.com>"

# The one super admin. Existing events are given to this account by `npm run backfill:owners`
SUPER_ADMIN_EMAIL=
